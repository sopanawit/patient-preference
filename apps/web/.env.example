# ============================================================================
# Environment สำหรับ frontend (Vite) — ค่าเหล่านี้เปิดเผยฝั่ง client ได้
# คัดลอกเป็น apps/web/.env แล้วใส่ค่าจริง
#
# ⚠️ ใส่ได้เฉพาะ anon key เท่านั้น — ห้ามใส่ service_role key หรือ API key ของโมเดล
#    (secret ของโมเดลอยู่ใน Supabase Edge Function เท่านั้น — ดู supabase/.env.example)
# ============================================================================

VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# เลือก data backend: 'mock' (ค่าเริ่มต้น — in-memory, ไม่ต้องมี backend) หรือ 'supabase'
# frontend-first phase ใช้ mock ; เมื่อทำ backend เสร็จค่อยตั้งเป็น supabase
VITE_DATA_BACKEND=mock

# เปิด/ปิดขั้นตอน "ตรวจสอบโดย CX" ทั้ง flow (ดู apps/web/src/lib/features.ts)
#   ไม่ตั้ง / ไม่ใช่ 'true' = ปิด (ค่าเริ่มต้นตอนนี้) — ไม่ต้องรอ CX, หน้าคนไข้โชว์แค่ความชอบ
#   'true' = เปิดกลับมาใช้คิวรอตรวจ + แสดง action รายแผนกตามเดิม
VITE_REVIEW_ENABLED=
